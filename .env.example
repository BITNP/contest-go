# 复制为 .env 并填写。
# app 和 postgres 都通过 env_file 读取这个文件。

# PostgreSQL
POSTGRES_DB=contest
POSTGRES_USER=contest
POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgres://contest:change-me@postgres:5432/contest?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# 会话
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true
DEV_LOGIN_ENABLED=false

# PostgreSQL 连接池
PG_MAX_CONNS=50
PG_MIN_CONNS=5
PG_MAX_CONN_LIFETIME=30m
PG_MAX_CONN_IDLE_TIME=5m
PG_HEALTH_CHECK_PERIOD=1m

# 竞赛规则
N_B=5
N_R=10
N_M=5
SCORE_B=5
SCORE_R=5
SCORE_M=5
QUIZ_DEADLINE=5m
QUIZ_MAX_TRIES=2
QUIZ_DRAFT_TTL=24h

# CAS
CAS_SERVER_URL=https://login.bit.edu.cn/cas/
CAS_SERVICE_URL=https://contest.bitnp.net/auth/cas/callback
CAS_LOGOUT_URL=
